{
  "name": "@local/conest-harness-core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./adapters/dsh": {
      "types": "./dist/adapters/dsh.d.mts",
      "import": "./dist/adapters/dsh.mjs"
    },
    "./adapters/openclaw-facade": {
      "types": "./dist/adapters/openclaw-facade.d.mts",
      "import": "./dist/adapters/openclaw-facade.mjs"
    },
    "./adapters/types": {
      "types": "./dist/adapters/types.d.mts",
      "import": "./dist/adapters/types.mjs"
    },
    "./state-store": {
      "types": "./dist/state-store.d.mts",
      "import": "./dist/state-store.mjs"
    },
    "./credentials": {
      "types": "./dist/credentials.d.mts",
      "import": "./dist/credentials.mjs"
    },
    "./adapters/host-binding": {
      "types": "./dist/adapters/host-binding.d.mts",
      "import": "./dist/adapters/host-binding.mjs"
    },
    "./public-v2": {
      "types": "./dist/public-v2.d.mts",
      "import": "./dist/public-v2.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && node scripts/check.mjs",
    "demo": "node examples/demo.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:dsh": "node --test test/integration/*.test.mjs",
    "demo:dsh": "node examples/dsh.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "node scripts/test-types.mjs",
    "pretest": "npm run typecheck && npm run build",
    "studio": "npm run build && node dist/studio/launch.mjs",
    "test:studio": "npm run build && node --test test/studio.test.mjs",
    "schema": "node scripts/config-schema.mjs",
    "control": "node scripts/control.mjs",
    "validate": "npm test && npm run test:types && npm run check && npm run test:dsh",
    "test:conformance": "npm run build && node --test test/conformance.test.mjs test/integration/dsh-conformance.test.mjs",
    "test:dsh:faults": "npm run build && node --test test/integration/dsh-http-faults.test.mjs",
    "lab:dsh": "npm run build && node examples/dsh-fault-lab.mjs",
    "test:lab:dsh": "npm run build && node --test test/integration/dsh-fault-lab.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  },
  "files": [
    "dist/",
    "scripts/",
    "examples/",
    "runtime.lock.json",
    "README.md"
  ]
}
