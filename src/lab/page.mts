/** Standalone lab shell. Runtime data is rendered with textContent, never HTML interpolation. */
export function labPage(nonce:string):string{return `<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CoNest · DSH 故障实验</title>
<style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#172d36;background:#f2f5f6;line-height:1.6}*{box-sizing:border-box}body{margin:0}main{max-width:1160px;margin:auto;padding:30px 24px 70px}header{display:flex;align-items:center;justify-content:space-between;gap:20px}.eyebrow{font-size:12px;letter-spacing:.12em;color:#48717b;font-weight:700}h1{font-size:28px;line-height:1.2;margin:8px 0 14px}h2{font-size:18px;margin:0 0 14px}h3{font-size:15px;margin:0 0 6px}p{margin:8px 0}.muted{color:#536d77;font-size:14px}.badge{border:1px solid #b9cdd2;border-radius:20px;padding:5px 12px;background:#fff;white-space:nowrap;font-size:13px}.notice{padding:14px 18px;border-left:4px solid #38838a;background:#e2f0f0;border-radius:6px;margin:18px 0}.grid{display:grid;grid-template-columns:1.15fr 1fr;gap:18px}.panel{background:#fff;border:1px solid #d7e1e4;border-radius:12px;padding:22px;margin:18px 0;box-shadow:0 2px 4px #18354305}.grid .panel{margin:0}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.auth input{flex:1;min-width:180px}input,select,button{font:inherit;border:1px solid #9aafb8;border-radius:7px;padding:8px 12px;max-width:100%}input,select{background:white;color:#172d36}button{cursor:pointer;background:#fff;color:#244951}button.primary{background:#1a6770;color:white;border-color:#1a6770}button.danger{color:#9c3530;border-color:#d6aaa6;background:#fff9f8}button:disabled{opacity:.44;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #e6ab46;outline-offset:3px}label{display:block;font-size:14px;margin:8px 0}label.inline{display:flex;gap:8px;align-items:flex-start}label.inline input{margin-top:6px}#message{padding:12px 16px;border-radius:7px;background:#fff4d7;white-space:pre-wrap}#message:empty{display:none}.instances{display:grid;grid-template-columns:1fr 1fr;gap:12px}.instance{background:#f7f9fa;border:1px solid #e0e7e9;border-radius:8px;padding:14px}.instance p{font-size:14px}#jobs{display:grid;gap:12px}.job{border:1px solid #d7e1e4;border-radius:9px;padding:15px}.job pre{white-space:pre-wrap;overflow-wrap:anywhere;margin-bottom:0;font:14px/1.6 ui-monospace,monospace}.job .meta{font-size:12px;color:#5a717c;overflow-wrap:anywhere}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:12px 0}.metric{background:#f0f5f6;padding:12px;border-radius:7px}.metric b{font-size:22px;display:block}ol{padding-left:22px}#timeline{max-height:360px;overflow:auto;font-size:13px}#timeline li{padding:5px 0;border-bottom:1px solid #edf1f2}pre.technical{max-height:440px;overflow:auto;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere}summary{cursor:pointer}small{color:#5a717c}.wide{width:100%}#riskBox{background:#fff6e6;padding:12px;border-radius:8px}footer{font-size:13px;color:#5a717c;margin-top:20px}@media(max-width:760px){main{padding:20px 14px 50px}.grid{grid-template-columns:1fr}header{align-items:flex-start;flex-direction:column}.metrics{grid-template-columns:1fr 1fr 1fr}.panel{padding:16px}.instances{grid-template-columns:1fr}h1{font-size:25px}}
</style></head><body><main>
<header><div><div class="eyebrow">CONEST / HARNESS LAB</div><h1>DSH 故障实验</h1><p class="muted">观察一次任务如何从运行走向结束，或留下需要处理的未知状态。</p></div><span class="badge">真实 DSH SDK · 本机模型 · 无付费调用</span></header>
<div class="notice">这是独立实验入口。所有工具收据只写入实验目录，故障仅作用于本实验拥有的进程。普通 Studio 和其他实例不会收到这些控制指令。</div>
<section class="panel auth"><h2>连接实验台</h2><label for="token">访问令牌：使用本次实验目录 connection.json 中的 token</label><div class="row"><input id="token" type="password" autocomplete="off" aria-label="实验台访问令牌" placeholder="输入实验令牌"><button id="connect" class="primary">连接</button><span id="connection" role="status">尚未连接</span></div><small>令牌仅保留在当前页面内存中。只读令牌可以观察，不能触发故障。</small></section>
<p id="message" role="alert" aria-live="polite"></p>
<div class="grid"><section class="panel"><h2>1. 开始一项任务</h2><label for="scenario">实例 A 的实验场景</label><select id="scenario" class="wide"><option value="normal">基线：正常完成</option><option value="model-wait">模型流：收到部分文字后等待</option><option value="partial-tool">工具参数：自动截断不完整调用</option><option value="tool-wait">工具收据：已写入，等待手动返回</option></select><p id="scenarioHelp" class="muted"></p><div class="row"><button id="runA" class="primary" disabled>启动 A 并运行</button><button id="runB" disabled>让 B 正常运行</button></div><p class="muted">B 用于检查隔离：A 故障时，B 应仍能独立完成。</p></section>
<section class="panel"><h2>2. 观察并注入故障</h2><label for="run">选择任务</label><select id="run" class="wide"><option value="">暂无任务</option></select><div class="row" style="margin-top:14px"><button id="cut" disabled>中断本机模型流</button><button id="cancel" disabled>取消所选任务</button><button id="release" disabled>释放工具返回</button></div><p class="muted">取消只结束调用方等待；若工具仍未返回，实际工作会继续被跟踪。</p><div class="row"><button id="killA" class="danger" disabled>终止 A 的 worker</button><button id="recoverA" disabled>回收并重启 A</button></div></section></div>
<section class="panel"><div class="row" style="justify-content:space-between"><h2>实例与进程</h2><span id="coordinator" class="badge">协调器：未连接</span></div><div id="instances" class="instances"></div><div class="row" style="margin-top:16px"><button id="crash" class="danger" disabled>终止本实验协调器</button><button id="restart" disabled>从同一状态重启协调器</button></div><p class="muted">先启动等待中的任务再终止协调器。页面会保持打开；重启后应看到持久化的未知记录，新任务被阻止，不会自动重放。</p></section>
<div class="grid"><section class="panel"><h2>模型与工具证据</h2><div class="metrics"><div class="metric"><b id="requestCount">0</b><small>HTTP 请求已接收</small></div><div class="metric"><b id="receiptCount">0</b><small>工具收据已提交</small></div><div class="metric"><b id="returnCount">0</b><small>工具已返回</small></div></div><p class="muted">计数来自当前选中的任务。HTTP 计数只涵盖本次页面服务启动后的请求，重启后的 0 不代表旧任务没有请求。连接关闭也不能证明外部模型计算或计费停止。</p><ol id="timeline" aria-label="任务证据时间线"></ol></section>
<section class="panel"><h2>未知执行记录</h2><p id="fenceSummary" class="muted">连接后查看。</p><label for="fence">选择未确认的记录</label><select id="fence" class="wide"><option value="">暂无记录</option></select><div id="riskBox" style="margin-top:14px"><label class="inline"><input id="risk" type="checkbox"><span>我接受旧任务可能仍有未知影响的风险，允许恢复接纳新任务。</span></label><button id="ack" disabled>接受风险并解除接纳阻塞</button></div><p class="muted">接受风险会保留“实际结果未知”。DSH 当前不能对旧任务进行原生对账，因此这里没有“确认已结束”按钮。</p></section></div>
<section class="panel"><h2>任务结果与实际工作</h2><div id="jobs"><p class="muted">连接后开始第一项实验。</p></div></section>
<details class="panel"><summary>查看技术证据与关联标识</summary><pre id="technical" class="technical"></pre></details>
<footer>可按项目文档逐项进行页面点击与视觉验收。运行中的任务最长等待 5 分钟；关闭实验服务时会释放本实验的等待工具并清理自有进程。</footer>
<script nonce="${nonce}">
'use strict';
const el=id=>document.getElementById(id);let accessToken='',state=null,busy=false,polling=false,connected=false,signature='',lastFence='',selectedRun='';
const scenarioNames={'normal':'正常完成','model-wait':'模型流等待','partial-tool':'不完整工具调用','tool-wait':'工具收据等待'};
const stateNames={running:'运行中',completed:'已完成',cancelled:'已取消',failed:'失败',interrupted:'已中断',ready:'就绪',stopped:'已停止',starting:'启动中','exit-observed':'已观察到退出','transport-lost':'通信丢失',created:'进程已创建',active:'仍有实际工作',settled:'本地工作已结束',unknown:'实际结果未知','acknowledged-unknown':'风险已接受，结果仍未知'};
const evidenceNames={'run.started':'任务已接纳','run.completed':'任务完成','run.failed':'任务失败','run.cancelled':'调用方已取消','run.interrupted':'调用方被中断','tool.started':'工具开始','tool.receipt-committed':'测试工具收据已提交','tool.cancel-observed':'工具已收到取消，但仍等待释放','tool.returned':'工具实际返回','worker.ready':'worker 就绪','worker.exit-observed':'worker 退出已确认','exit-observed':'worker 退出已观察','transport-lost':'worker 通信丢失','coordinator.exit-observed':'协调器退出已确认'};
const errorNames={TOKEN_REQUIRED:'令牌无效，请使用当前实验目录中的令牌。',MANAGEMENT_DENIED:'当前令牌只允许观察。',RUN_OUTCOME_UNKNOWN:'仍有未知执行记录，请先检查记录并决定是否接受风险。',INSTANCE_BUSY:'实际工具工作尚未结束，请先释放工具返回。',LAB_STAGE:'当前阶段不能执行此操作，请刷新状态。',LAB_COORDINATOR_DOWN:'协调器已停止，请从同一状态重启。',INSTANCE_NOT_READY:'实例未就绪，请先回收并重启。',LAB_OUTCOME_UNKNOWN:'操作结果未得到确认。请观察状态，不要重复提交。'};
function message(text){el('message').textContent=text;}
async function api(route,data){const response=await fetch('/api/'+route,{method:data?'POST':'GET',headers:{Authorization:'Bearer '+accessToken,...(data?{'Content-Type':'application/json'}:{})},...(data?{body:JSON.stringify(data)}:{})});const value=await response.json();if(!response.ok)throw Error(errorNames[value.error]||value.error||'请求失败');return value;}
function options(id,items){const node=el(id),old=node.value,key=JSON.stringify(items);if(node.dataset.key===key)return;node.dataset.key=key;node.replaceChildren();for(const item of items){const option=document.createElement('option');option.value=item[0];option.textContent=item[1];node.append(option);}if(items.some(i=>i[0]===old))node.value=old;}
function button(id,enabled){el(id).disabled=busy||!connected||!state?.permissions.includes('lab:control')||!enabled;}
function help(){el('scenarioHelp').textContent=({'normal':'建立基线：真实 DSH 从本机模型收到完整响应，任务应正常完成。','model-wait':'本机模型会先发送部分文字，再等待。看到请求证据后，可以中断流、取消任务或终止进程。','partial-tool':'模型只发送半个工具参数后断开。任务应失败，工具收据计数应为 0。','tool-wait':'DSH 会实际调用测试工具。写入收据后暂停返回；先取消再释放，可以观察调用方状态与实际工作状态的区别。'})[el('scenario').value];}
function render(){if(!state)return;
 const ready=state.coordinator==='ready',a=state.instances.find(i=>i.id==='a'),b=state.instances.find(i=>i.id==='b');
 options('run',state.jobs.length?[...state.jobs].reverse().map(j=>[j.runId,j.instanceId.toUpperCase()+' · '+scenarioNames[j.scenario]+' · '+j.runId.slice(0,8)]):[['','暂无任务']]);
 if(selectedRun&&state.jobs.some(j=>j.runId===selectedRun)){el('run').value=selectedRun;selectedRun='';}
 const job=state.jobs.find(j=>j.runId===el('run').value),receipts=state.modelReceipts.filter(r=>r.runId===job?.runId),events=[...(job?.events||[])];
 el('coordinator').textContent='协调器：'+(stateNames[state.coordinator]||state.coordinator);
 const instanceKey=JSON.stringify([state.instances,state.workers,state.coordinator]);
 if(el('instances').dataset.key!==instanceKey){el('instances').dataset.key=instanceKey;el('instances').replaceChildren();for(const i of state.instances){const card=document.createElement('div');card.className='instance';const h=document.createElement('h3');h.textContent='实例 '+i.id.toUpperCase();card.append(h);for(const text of ['状态：'+(stateNames[i.state]||i.state),'实际运行数：'+i.activeRuns,'资源：'+({held:'持有中',released:'已释放',unconfirmed:'未确认或待回收',acquiring:'获取中',releasing:'清理中'}[i.resourceState]||'等待观测'),'worker：'+(ready?(stateNames[state.workers[i.id]]||state.workers[i.id]||'尚未启动'):'协调器失联，旧 worker 状态未独立确认'),i.lastError?'原因：'+i.lastError:'接纳：'+(i.admissionBlocked?'被未知记录阻止':'可按权限提交')]){const p=document.createElement('p');p.textContent=text;card.append(p);}el('instances').append(card);}}
 button('runA',ready&&a&&!a.activeRuns&&!a.admissionBlocked&&['ready','stopped'].includes(a.state));button('runB',ready&&b&&!b.activeRuns&&!b.admissionBlocked&&['ready','stopped'].includes(b.state));
 button('cut',ready&&receipts.some(r=>r.stage==='streaming'));button('cancel',ready&&job?.state==='running');button('release',ready&&job?.executionState==='active'&&events.some(e=>e.type==='tool.receipt-committed')&&!events.some(e=>e.type==='tool.returned'));button('killA',ready&&['ready','created'].includes(state.workers.a));button('recoverA',ready&&a&&!a.activeRuns);button('crash',ready&&state.jobs.some(j=>j.state==='running'));button('restart',state.coordinator==='exit-observed');
 const uncertain=state.fences.filter(f=>f.status==='uncertain');options('fence',uncertain.length?uncertain.map(f=>[f.runId,f.instanceId.toUpperCase()+' · '+f.runId.slice(0,8)]):[['','暂无待处置记录']]);
 if(el('fence').value!==lastFence){lastFence=el('fence').value;el('risk').checked=false;}
 el('fenceSummary').textContent=state.fences.length?state.fences.map(f=>f.instanceId.toUpperCase()+'：'+({uncertain:'未知，阻止新接纳','in-flight':'派发意图已持久化，尚无结束证据',acknowledged:'已接受风险，实际结果仍未知','confirmed-ended':'提供方已确认结束'})[f.status]).join('；'):'暂无持久化执行记录。';
 button('ack',ready&&uncertain.some(f=>f.runId===el('fence').value)&&el('risk').checked);
 el('requestCount').textContent=String(receipts.length);el('receiptCount').textContent=String(events.filter(e=>e.type==='tool.receipt-committed').length);el('returnCount').textContent=String(events.filter(e=>e.type==='tool.returned').length);
 const timeline=[...events,...state.events.filter(e=>e.type.startsWith('coordinator.')||e.instanceId===job?.instanceId&&!e.runId),...receipts.map(r=>({at:r.at,type:'模型端已接收 HTTP 请求 #'+r.iteration+' · '+({streaming:'流仍打开',ended:'响应发送结束',closed:'流已关闭'})[r.stage]}))].sort((a,b)=>a.at.localeCompare(b.at));
 el('timeline').replaceChildren();for(const e of timeline){const li=document.createElement('li');li.textContent=new Date(e.at).toLocaleTimeString()+' · '+(evidenceNames[e.type]||e.type);el('timeline').append(li);}
 const key=JSON.stringify(state.jobs);if(key!==signature){signature=key;el('jobs').replaceChildren();for(const j of [...state.jobs].reverse()){const card=document.createElement('article');card.className='job';const h=document.createElement('h3');h.textContent=j.instanceId.toUpperCase()+' · '+scenarioNames[j.scenario]+' · '+(stateNames[j.state]||j.state);const meta=document.createElement('div');meta.className='meta';meta.textContent='实际工作：'+(stateNames[j.executionState]||j.executionState)+' · '+j.runId;const pre=document.createElement('pre');pre.textContent=j.text||'等待结果或故障证据…';card.append(h,meta,pre);el('jobs').append(card);}}
 el('technical').textContent=JSON.stringify(state,null,2);
}
async function refresh(){if(!connected||polling||busy)return;polling=true;try{state=await api('state');render();}catch(error){message(error.message);}finally{polling=false;}}
async function act(action){if(busy)return;busy=true;message('');render();try{const result=await api('action',{id:crypto.randomUUID(),...action});if(result.runId)selectedRun=result.runId;}catch(error){message(error.message);}finally{busy=false;await refresh();render();}}
el('connect').onclick=async()=>{accessToken=el('token').value.trim();connected=true;try{state=await api('state');el('connection').textContent=state.permissions.includes('lab:control')?'已连接 · 可控制':'已连接 · 只读';message('');render();}catch(error){connected=false;el('connection').textContent='连接失败';message(error.message);render();}};
el('scenario').onchange=help;el('run').onchange=render;el('risk').onchange=render;el('fence').onchange=()=>{el('risk').checked=false;render();};
el('runA').onclick=()=>act({action:'run',instanceId:'a',scenario:el('scenario').value});el('runB').onclick=()=>act({action:'run',instanceId:'b',scenario:'normal'});
el('cut').onclick=()=>act({action:'cut-stream',runId:el('run').value});el('cancel').onclick=()=>act({action:'cancel',runId:el('run').value});el('release').onclick=()=>act({action:'release-tool',runId:el('run').value});
el('killA').onclick=()=>act({action:'terminate-worker',instanceId:'a'});el('recoverA').onclick=()=>act({action:'restart-instance',instanceId:'a'});el('crash').onclick=()=>act({action:'crash-coordinator'});el('restart').onclick=()=>act({action:'restart-coordinator'});
el('ack').onclick=()=>{const f=state.fences.find(f=>f.runId===el('fence').value);if(f&&el('risk').checked)void act({action:'acknowledge',instanceId:f.instanceId,runId:f.runId,token:f.token,acceptRisk:true});};
help();setInterval(()=>{void refresh();},800);
</script></main></body></html>`;}
