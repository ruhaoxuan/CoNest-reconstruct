import { RPC_METHODS } from '../rpc.mjs';
import { instanceView, jobView, groupTools, errorView } from './presentation.mjs';

export function page(nonce: string, mode: 'proof' | 'live' = 'proof'): string {
  const live = mode === 'live';
  return `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CoNest · Harness Studio</title>
<style>
:root{color-scheme:dark;--bg:#10151d;--panel:#192330;--line:#354557;--text:#e9eff7;--muted:#a7b7ca;--accent:#c4eea0}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.6 system-ui}main{max-width:1320px;margin:auto;padding:28px}header{display:flex;align-items:center;justify-content:space-between;gap:16px}h1,h2,h3,p{margin:0 0 12px}h1{font-size:28px}h2{font-size:19px}h3{font-size:16px}small,.muted{color:var(--muted)}.eyebrow{font-size:12px;letter-spacing:2px;color:var(--accent)}.layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:22px;margin-top:22px}section,.instance-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px}section{margin-bottom:18px}.instance-card{padding:14px;margin-top:10px;text-align:left;width:100%;color:var(--text);background:transparent}.instance-card.selected{border-color:var(--accent);background:#24332d}.card-meta{display:block;color:var(--muted);font-size:13px}.badge{display:inline-block;border:1px solid #58706c;background:#20322d;color:var(--accent);padding:3px 10px;border-radius:20px;font-size:12px}.badge.warning{color:#ffd28b;background:#382f21;border-color:#76603b}.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}button,input,select,textarea{font:inherit;border:1px solid #53667d;border-radius:7px;padding:9px 12px}button{background:var(--accent);color:#142313;cursor:pointer}button.secondary{background:transparent;color:var(--text)}button.danger{background:#412a2b;color:#ffd1ce;border-color:#82524f}button:disabled{opacity:.4;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}input,select,textarea{background:var(--bg);color:var(--text);width:100%}textarea{min-height:120px;resize:vertical;margin-top:12px}label{display:block;margin:10px 0 6px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.7 ui-monospace,monospace;margin:10px 0}#notice{color:#ffd28b;min-height:24px;margin-top:12px}#status{padding:12px;background:#101a22;border-radius:8px;margin-top:12px}.job{padding:20px 0;border-top:1px solid var(--line)}.job:first-child{border-top:0}.job-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.answer{background:#101a22;border-radius:8px;padding:14px}.tool{border-left:2px solid #718e66;padding-left:12px;margin:14px 0}summary{cursor:pointer;color:var(--muted)}.hint{color:#ffd28b;font-size:13px}.empty{color:var(--muted);padding:16px 0}.technical{margin-top:14px}#jobs:empty:after{content:'暂无任务。选择实例并启动后，可以提交任务。';color:var(--muted)}@media(max-width:850px){main{padding:18px}.layout{grid-template-columns:1fr}header{align-items:flex-start}.job-head{flex-wrap:wrap}}
</style></head><body><main>
<header><div><div class="eyebrow">CONEST / HARNESS CONTROL</div><h1>统一 Harness 工作台</h1><p class="muted">管理实例，查看任务与工具证据。</p></div><span class="badge ${live ? 'warning' : ''}">${live ? 'LIVE 任务模式' : 'PROOF 演示模式'}</span></header>
<p class="muted">${live ? '任务会调用真实模型并可能产生 API 费用。可用工具仅限工作区读取、目录和搜索。' : '使用真实 DSH 循环与合成工具回调；无需 API Key，不执行真实 Shell。'}</p>
<div class="layout"><aside>
<section><h2>连接工作台</h2><label for="token">本次启动的访问令牌</label><input id="token" type="password" autocomplete="off"><div class="toolbar"><button id="connect">连接</button><span id="access" class="badge">未连接</span></div><p id="notice" role="status" aria-live="polite">输入 connection.json 中的令牌。</p></section>
<section><h2>Harness 实例</h2><label for="instance">当前实例</label><select id="instance"></select><div id="cards"></div><div id="status">尚未连接</div>
<div class="toolbar"><button id="start" disabled>启动实例</button><button id="stop" class="secondary" disabled>停止实例</button><button id="force" class="danger" disabled>强制回收自有进程</button></div>
<div class="toolbar"><button id="revoke" class="danger" disabled>撤销任务权限</button><button id="restore" class="secondary" disabled>恢复任务权限</button></div>
<p class="muted"><small>撤权和收窄后的策略保存在当前状态目录。</small></p>
<div class="toolbar"><button id="reset" class="secondary" disabled>解除重启限制</button></div>
<details class="technical"><summary>按主体和工具收窄权限</summary><p class="muted">只能在启动配置的授权上限内调整；保存后会取消在途任务。</p><textarea id="policy-input" aria-label="实例权限策略" placeholder="先读取当前策略"></textarea><div class="toolbar"><button id="load-policy" class="secondary" disabled>读取策略</button><button id="apply-policy" class="secondary" disabled>保存策略</button></div></details><details class="technical"><summary>实例技术信息</summary><pre id="diagnostics"></pre></details></section><section><h2>未确认执行</h2><div id="fences"></div></section></aside>
<div><section><h2>新任务</h2><p class="muted">${live ? '文件内容将作为工具结果发给所选模型。' : 'test.echo 可直接输入测试文本；DSH 使用下方演示预设。'}</p>
<div class="toolbar"><button id="preset" class="secondary">${live ? '读取项目文件' : '工具回调演示'}</button><button id="wait" class="secondary" ${live ? 'hidden' : ''}>取消演示</button></div>
<textarea id="input" aria-label="任务内容">${live ? '请读取 project-test.txt，汇总负责人、剩余预算、交付日期和风险，注明来源。' : 'PROOF:BASH:'}</textarea><div class="toolbar"><button id="run" disabled>运行任务</button><small id="admission">请先连接并启动实例。</small></div></section>
<section><div class="job-head"><h2>执行记录</h2><small>本地保存 · 最近 100 项</small></div><div id="jobs"></div></section></div></div></main>
<script nonce="${nonce}">
const instanceView=${instanceView.toString()};
const jobView=${jobView.toString()};
const groupTools=${groupTools.toString()};
const errorView=${errorView.toString()};
const rpcMethods=${JSON.stringify(Object.fromEntries(Object.entries(RPC_METHODS).filter(([,v])=>!v.read).map(([method,value])=>[value.route.slice(5),method])))};
const $=id=>document.getElementById(id);let token='',busy=false,current=null,refreshId=0,policyInstanceId='';const riskAccepted=new Set();
function node(tag,text,cls){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n;}
async function api(route,data){const rpc=data?{version:1,id:crypto.randomUUID(),method:rpcMethods[route],params:data}:undefined;let r;try{r=await fetch(data?'/rpc':'/api/'+route,{method:data?'POST':'GET',headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},...(data?{body:JSON.stringify(rpc)}:{})});}catch{throw Error(data?'RPC_OUTCOME_UNKNOWN':'Failed to fetch');}const value=await r.json();if(!r.ok||(data&&value.ok!==true))throw Error(typeof value.error==='string'?value.error:value.error?.code||r.status);return data?value.result:value;}
function renderFences(s,i){$('fences').replaceChildren();const records=(s.executionFences||[]).filter(f=>f.instanceId===i?.id&&['uncertain','acknowledged'].includes(f.status));if(!records.length){$('fences').append(node('p','当前实例没有待处置的未知执行。','muted'));return;}for(const f of records){const row=node('div',undefined,'tool'),key=JSON.stringify([f.instanceId,f.runId,f.token]);row.append(node('strong',f.runId),node('p',f.status==='acknowledged'?'已接受风险；实际执行终态仍未知。':'执行终态未确认；当前接纳被阻止。','hint'));const query=node('button','向提供方对账','secondary');query.dataset.fenceAction='query';query.disabled=busy||!s.permissions.includes('access:manage')||!i?.canReconcile;query.onclick=()=>action('execution-reconcile',{instanceId:f.instanceId,runId:f.runId,token:f.token});row.append(query);if(f.status==='uncertain'){const label=node('label'),check=node('input');check.type='checkbox';check.checked=riskAccepted.has(key);check.disabled=busy||!s.permissions.includes('access:manage')||Boolean(i?.activeRuns);check.onchange=()=>{if(check.checked)riskAccepted.add(key);else riskAccepted.delete(key);buttons();};label.append(check,document.createTextNode('我已外部核查，或接受旧任务仍可能运行的风险'));const ack=node('button','接受风险并解除接纳栅栏','danger');ack.dataset.fenceAction='ack';ack.dataset.key=key;ack.onclick=()=>action('execution-acknowledge',{instanceId:f.instanceId,runId:f.runId,token:f.token,acceptRisk:true});row.append(label,ack);}row.append(node('small','无对账能力时按钮禁用。解除接纳不等于证明执行已结束。'));$('fences').append(row);}}
function buttons(){const i=current?.instances.find(i=>i.id===$('instance').value);const v=i?instanceView(i,current.permissions,busy):{},pending=current?.jobs.some(j=>j.instanceId===i?.id&&j.state==='running');if(pending)v.run=false;for(const id of ['start','stop','run','revoke','restore','force','reset'])$(id).disabled=!token||!v[id];for(const id of ['load-policy','apply-policy'])$(id).disabled=!token||!v.policy||(id==='apply-policy'&&policyInstanceId!==$('instance').value);for(const b of document.querySelectorAll('[data-fence-action]'))b.disabled=!token||busy||!current?.permissions.includes('access:manage')||(b.dataset.fenceAction==='query'?!i?.canReconcile:!riskAccepted.has(b.dataset.key)||Boolean(i?.activeRuns));$('policy-input').readOnly=!token||!v.policy;$('admission').textContent=!i?'请选择实例。':v.run?'可接纳新任务。':i.admissionBlocked?'存在未确认执行，请先对账或明确处置。':i.taskAccess==='revoked'?'任务权限已撤销，请先恢复。':i.activeRuns||pending?'前一任务的实际工作尚未结束。':i.state!=='ready'?'请先启动实例。':'当前访问权限或操作状态不允许提交。';}
function render(s){current=s;if(s.storage?.status==='failed')$('notice').textContent='本地记录写入异常，执行结果与持久记录请分别核对。';const selected=$('instance').value,expanded=new Set([...document.querySelectorAll('details[data-key][open]')].map(d=>d.dataset.key));$('instance').replaceChildren();for(const i of s.instances){const option=node('option',i.id+' · '+i.provider);option.value=i.id;$('instance').append(option);}if(s.instances.some(i=>i.id===selected))$('instance').value=selected;
$('access').textContent=s.permissions.includes('instance:control')?'管理访问':s.permissions.length===1&&s.permissions[0]==='state:read'?'只读访问':'受限访问';$('cards').replaceChildren();for(const i of s.instances){const v=instanceView(i,s.permissions);const card=node('button',undefined,'instance-card'+(i.id===$('instance').value?' selected':''));card.append(node('strong',i.id),node('span',v.status+' · '+i.activeRuns+' 项工作','card-meta'),node('span',v.resources,'card-meta'));card.onclick=()=>{if($('instance').value!==i.id){policyInstanceId='';$('policy-input').value='';}$('instance').value=i.id;render(current);};$('cards').append(card);}
const i=s.instances.find(i=>i.id===$('instance').value);$('status').replaceChildren();if(i){const v=instanceView(i,s.permissions);$('status').append(node('strong',v.status),node('div',v.access),node('div',v.resources,'muted'));if(i.admissionBlocked)$('status').append(node('p','存在 '+i.unconfirmedRuns+' 项未确认执行；停止或重启不会解除接纳栅栏。','hint'));if(i.nextStartAt>Date.now())$('status').append(node('p','可再次启动时间：'+new Date(i.nextStartAt).toLocaleTimeString(),'hint'));if(i.ownership!=='owned')$('status').append(node('p','外部服务：停止仅取消本工作台任务并解除连接，不关闭外部 Harness 服务。','muted'));if(i.toolPublication)$('status').append(node('div','发布 '+i.toolPublication.tools.length+' 个工具 · '+i.toolPublication.revision.slice(0,10),'muted'));if(i.lastError)$('status').append(node('p',errorView(i.lastError),'hint'));}$('diagnostics').textContent=i?JSON.stringify(i,null,2):'暂无实例';
renderFences(s,i);$('jobs').replaceChildren();for(const j of [...s.jobs].reverse()){const v=jobView(j),article=node('article',undefined,'job'),head=node('div',undefined,'job-head'),title=node('div');title.append(node('h3',j.instanceId+' · '+v.status),node('small',j.startedAt));head.append(title);if(j.state==='running'){const cancel=node('button',j.cancelRequested?'取消已请求':'取消任务','secondary');cancel.disabled=busy||j.cancelRequested||!s.permissions.includes('task:cancel');cancel.onclick=()=>action('cancel',{id:j.id});head.append(cancel);}article.append(head,node('p',v.work,'muted'));if(j.text){article.append(node('pre',j.state==='completed'?j.text:errorView(j.text),'answer'));if(j.resultTruncated)article.append(node('p','回答仅显示前 8000 字符，已截断。','hint'));}
const tools=groupTools(j.events||[],j.state!=='running');if(tools.length){const details=node('details'),summary=node('summary','执行轨迹 · '+tools.length+' 次工具调用');details.dataset.key=j.id;details.open=expanded.has(j.id);details.append(summary);const labels={running:'执行中',completed:'已完成',failed:'失败',cancelled:'已取消',unconfirmed:'未收到工具终态'};for(const t of tools){const row=node('div',undefined,'tool');row.append(node('strong',t.name+' · '+(labels[t.status]||t.status)+(t.durationMs===undefined?'':' · '+t.durationMs+' ms')));if(t.errorCode||t.preview)row.append(node('pre',t.errorCode||t.preview));if(t.previewTruncated)row.append(node('p','工具结果摘要已截断至 2000 字符。','hint'));details.append(row);}if(j.droppedEvents)details.append(node('p','已省略较早的 '+j.droppedEvents+' 条事件；工具轨迹可能不完整。','hint'));article.append(details);}
const technical=node('details',undefined,'technical');technical.dataset.key=j.id+'-technical';technical.open=expanded.has(technical.dataset.key);technical.append(node('summary','任务技术信息'),node('pre',JSON.stringify({jobId:j.id,runId:j.runId,state:j.state,executionState:j.executionState,cancelRequested:j.cancelRequested},null,2)));article.append(technical);$('jobs').append(article);}buttons();}
async function refresh(){const id=++refreshId,s=await api('state');if(id===refreshId&&token)render(s);}
async function action(route,data){busy=true;buttons();$('notice').textContent='正在处理，请稍候…';try{const result=await api(route,data);await refresh();$('notice').textContent=route==='execution-acknowledge'?'接纳栅栏已解除；原执行终态仍未知。':route==='execution-reconcile'?(result.status==='settled'?'提供方已确认执行结束。':'提供方未确认结束，栅栏继续保留。'):'操作已提交，状态已刷新。';}catch(e){$('notice').textContent=errorView(e.message);await refresh().catch(()=>{});}finally{busy=false;buttons();}}
$('connect').onclick=async()=>{riskAccepted.clear();token=$('token').value.trim();try{await refresh();$('token').value='';$('notice').textContent='已连接 · ${mode}';}catch(e){token='';current=null;$('notice').textContent=errorView(e.message);}buttons();};
for(const id of ['start','stop','revoke','restore'])$(id).onclick=()=>action(id,{instanceId:$('instance').value});$('run').onclick=()=>action('run',{instanceId:$('instance').value,input:$('input').value});$('instance').onchange=()=>{policyInstanceId='';$('policy-input').value='';if(current)render(current);};
$('force').onclick=()=>action('stop',{instanceId:$('instance').value,force:true});$('reset').onclick=()=>action('reset-restarts',{instanceId:$('instance').value});$('load-policy').onclick=async()=>{try{const id=$('instance').value;const r=await api('policy?instanceId='+encodeURIComponent(id));if($('instance').value!==id)return;policyInstanceId=id;$('policy-input').value=JSON.stringify(r.policy,null,2);buttons();}catch(e){$('notice').textContent=errorView(e.message);}};$('apply-policy').onclick=()=>{try{if(policyInstanceId!==$('instance').value)throw Error('Policy selection changed');const policy=JSON.parse($('policy-input').value);return action('policy',{instanceId:$('instance').value,policy});}catch{$('notice').textContent='策略需要是有效的 JSON。';}};
$('preset').onclick=()=>{$('input').value=${JSON.stringify(live ? '请读取 project-test.txt，汇总负责人、剩余预算、交付日期和风险，注明来源。' : 'PROOF:BASH:')};};$('wait').onclick=()=>{$('input').value='PROOF:BASH:WAIT';};
setInterval(()=>{if(token&&!document.hidden)refresh().catch(e=>{$('notice').textContent=errorView(e.message);});},1500);buttons();
</script></body></html>`;
}
